# Copie este arquivo para ".env" e ajuste os valores antes de rodar a API.
#   Windows:    copy .env.example .env
#   Linux/Mac:  cp .env.example .env

# "desenvolvimento" ou "producao".
# Em "producao" a API se RECUSA a subir com segredos de exemplo ou CORS "*".
AMBIENTE=desenvolvimento

# Segredos usados para assinar os JWTs. Precisam ter no mínimo 32 caracteres
# e ser DIFERENTES entre si. Gere cada um com:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Deixar em branco em desenvolvimento faz a API gerar um segredo temporário
# na memória (seguro, mas desloga todo mundo a cada reinício).
JWT_SECRET_CLIENTE=
JWT_SECRET_ADMIN=

JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS_CLIENTE=1440
JWT_EXPIRA_MINUTOS_ADMIN=480

# Caminho do arquivo do banco SQLite (relativo à pasta apps/api)
DATABASE_PATH=database/burger_tech.db

# Origens permitidas para CORS, separadas por vírgula (o dev server do Vite roda em 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
